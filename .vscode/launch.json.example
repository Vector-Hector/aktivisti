{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "type": "chrome",
      "request": "launch",
      "name": "Quasar App: chrome",
      "url": "http://localhost:8080",
      // To properly reflect changes after HMR with Vite
      "enableContentValidation": false,
      "webRoot": "${workspaceFolder}/src",
      // If you're using chromium instead of chrome uncomment the following line
      // and set the path to your chromium executable
      // "runtimeExecutable": "/usr/bin/chromium",
      // No need to configure sourcemap explicitly for vite.
      "sourceMapPathOverrides": {
        "webpack://wk-frontend/./src/*": "${webRoot}/*"
      },
      "timeout": 50000
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Quasar App: chrome (persistent)",
      "url": "http://localhost:8080",
      // To properly reflect changes after HMR with Vite
      "enableContentValidation": false,
      "webRoot": "${workspaceFolder}/src",
      // If you're using chromium instead of chrome uncomment the following line
      // and set the path to your chromium executable
      // "runtimeExecutable": "/usr/bin/chromium",
      // No need to configure sourcemap explicitly for vite.
      "sourceMapPathOverrides": {
        "webpack://wk-frontend/./src/*": "${webRoot}/*"
      },
      "timeout": 50000,
      "userDataDir": "${workspaceFolder}/.vscode/vscode-chrome-debug-userdatadir"
    }
  ]
}
